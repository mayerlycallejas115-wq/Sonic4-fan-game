<!DOCTYPE html>
<html>
<head>
    <title>Sonic 4 Fan Game Mobile</title>
    <script src="https://cdn.jsdelivr.net/npm/phaser@3.70.0/dist/phaser.min.js"></script>
    <style> 
        body { margin: 0; background: #87CEEB; overflow: hidden; } 
        canvas { display: block; margin: 0 auto; } 
        .btn { position: absolute; bottom: 20px; width: 80px; height: 80px; background: rgba(255,255,255,0.3); border-radius: 50%; border: 3px solid white; font-size: 30px; color: white; }
        #left { left: 20px; }
        #right { left: 120px; }
        #jump { right: 120px; }
        #attack { right: 20px; }
    </style>
</head>
<body>
<button class="btn" id="left">◀</button>
<button class="btn" id="right">▶</button>
<button class="btn" id="jump">A</button>
<button class="btn" id="attack">B</button>

<script>
const config = {
    type: Phaser.AUTO, 
    width: 800, 
    height: 450,
    physics: { 
        default: 'arcade', 
        arcade: { gravity: { y: 1000 }
    },
    scene: { preload, create, update }
};

let player, rings, ringCount = 0, ringText, enemies, ground;
let moveLeft = false, moveRight = false, jumpPressed = false, attackPressed = false;

new Phaser.Game(config);

function preload(){}

function create(){
    this.cameras.main.setBackgroundColor('#87CEEB');
    
    ground = this.physics.add.staticGroup();
    ground.create(400, 440, null).setScale(20,1).refreshBody();
    ground.create(300, 380, null).setScale(4,0.5).refreshBody();
    
    player = this.physics.add.rectangle(100, 350, 25, 35, 0x0066ff);
    player.setCollideWorldBounds(true);
    this.physics.add.collider(player, ground);
    
    rings = this.physics.add.group();
    for(let i=0; i<50; i++){ 
        rings.create(200 + i*15, 360, null).setScale(0.1).setTint(0xffff00); 
    }
    this.physics.add.overlap(player, rings, (p,r)=>{
        r.destroy(); 
        ringCount++; 
        ringText.setText('Rings: '+ringCount);
    }, null, this);
    
    enemies = this.physics.add.group();
    enemies.create(500, 360, null).setScale(0.3).setTint(0xff0000);
    this.physics.add.collider(enemies, ground);
    
    ringText = this.add.text(16,16,'Rings: 0',{fontSize:'24px',fill:'#000'}).setScrollFactor(0);
    this.cameras.main.startFollow(player);

    // CONTROLES TÁCTILES
    document.getElementById('left').ontouchstart = () => moveLeft = true;
    document.getElementById('left').ontouchend = () => moveLeft = false;
    document.getElementById('right').ontouchstart = () => moveRight = true;
    document.getElementById('right').ontouchend = () => moveRight = false;
    document.getElementById('jump').ontouchstart = () => jumpPressed = true;
    document.getElementById('jump').ontouchend = () => jumpPressed = false;
    document.getElementById('attack').ontouchstart = () => attackPressed = true;
    document.getElementById('attack').ontouchend = () => attackPressed = false;
}

function update(){
    // MOVIMIENTO
    if(moveLeft) player.setVelocityX(-300);
    else if(moveRight) player.setVelocityX(300);
    else player.setVelocityX(player.body.velocity.x * 0.8);
    
    // SALTO
    if(jumpPressed && player.body.onFloor()){
        player.setVelocityY(-550);
        jumpPressed = false;
    }
    
    // HOME ATTACK
    if(attackPressed && !player.body.onFloor()){
        let target = enemies.getChildren().find(e => Phaser.Math.Distance.Between(player.x,player.y,e.x,e.y) < 200);
        if(target) this.physics.moveToObject(player, target, 700);
